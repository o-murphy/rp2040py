{
  "micropython": {
    "filename_template": "RPI_PICO-{version}.uf2",
    "url_template": "https://micropython.org/resources/firmware/{filename}",
    "default_tag": "1.21.0",
    "known_versions": {
      "1.16": "20210618-v1.16",
      "1.17": "20210902-v1.17",
      "1.18": "20220117-v1.18",
      "1.19.1": "20220618-v1.19.1",
      "1.20.0": "20230426-v1.20.0",
      "1.21.0": "20231005-v1.21.0",
      "1.28.0": "20260406-v1.28.0"
    }
  },
  "circuitpython": {
    "filename_template": "adafruit-circuitpython-raspberry_pi_pico-en_US-{version}.uf2",
    "url_template": "https://adafruit-circuit-python.s3.amazonaws.com/bin/raspberry_pi_pico/en_US/{filename}",
    "default_tag": "8.0.2"
  },
  "kaluma": {
    "filename_template": "kaluma-rp2-pico-{version}.uf2",
    "url_template": "https://github.com/kaluma-project/kaluma/releases/download/{version}/{filename}",
    "default_tag": "1.2.1"
  }
}
